{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nerqia.app" }],
      "destination": "https://nerqia.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "^(?!(?:www|app|api|admin|platform|finance|auth|docs|help|status|soporte|mail|cdn|assets|developer)\\.nerqia\\.app$)(?<storeSlug>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.nerqia\\.app$" }],
      "destination": "/api/robots?hostSlug=:storeSlug"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "^(?!(?:www|app|api|admin|platform|finance|auth|docs|help|status|soporte|mail|cdn|assets|developer)\\.nerqia\\.app$)(?<storeSlug>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.nerqia\\.app$" }],
      "destination": "/api/sitemap?hostSlug=:storeSlug&path=/"
    },
    {
      "source": "/feed.xml",
      "has": [{ "type": "host", "value": "^(?!(?:www|app|api|admin|platform|finance|auth|docs|help|status|soporte|mail|cdn|assets|developer)\\.nerqia\\.app$)(?<storeSlug>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.nerqia\\.app$" }],
      "destination": "/api/feed?hostSlug=:storeSlug&path=/"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-index"
    },
    {
      "source": "/tienda/:slug/sitemap.xml",
      "destination": "/api/sitemap?path=/tienda/:slug"
    },
    {
      "source": "/tienda/:slug/feed.xml",
      "destination": "/api/feed?path=/tienda/:slug"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(?!(?:www|app|api|admin|platform|finance|auth|docs|help|status|soporte|mail|cdn|assets|developer)\\.nerqia\\.app$)(?<storeSlug>[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\\.nerqia\\.app$"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|Twitterbot|Slackbot|LinkedInBot|TelegramBot|Discordbot|Googlebot|Google-InspectionTool|AdsBot-Google|Storebot-Google|GoogleOther|bingbot|BingPreview|DuckDuckBot|YandexBot|Applebot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|embedly).*"
        }
      ],
      "destination": "/api/og?hostSlug=:storeSlug&path=/:path*"
    },
    {
      "source": "/tienda/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|facebookcatalog|WhatsApp|Twitterbot|Slackbot|LinkedInBot|TelegramBot|Discordbot|Googlebot|Google-InspectionTool|AdsBot-Google|Storebot-Google|GoogleOther|bingbot|BingPreview|DuckDuckBot|YandexBot|Applebot|Pinterest|redditbot|SkypeUriPreview|vkShare|W3C_Validator|embedly).*"
        }
      ],
      "destination": "/api/og?path=/tienda/:path*"
    },
    { "source": "/((?!api/|assets/|developer/|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.resend.com https://api.anthropic.com https://dolarapi.com https://api.qrserver.com; frame-src 'none'; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/registerSW.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/developer/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    }
  ]
}
