# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Stripe (frontend — solo la clave pública)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe (solo para Edge Functions en Supabase — NO incluir aquí)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Tiendanube (crear app en https://www.tiendanube.com/partners)
VITE_TIENDANUBE_APP_ID=your_tiendanube_app_id
# Tiendanube secrets (solo para Edge Functions en Supabase — NO incluir aquí)
# TIENDANUBE_CLIENT_ID=...
# TIENDANUBE_CLIENT_SECRET=...

# Anthropic (para Edge Functions)
# ANTHROPIC_API_KEY=sk-ant-...
