# ============================================================
# FRONTEND — copiar este archivo a .env y completar los valores
# ============================================================

# Supabase (obligatorio)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Stripe — solo la clave pública para frontend (obligatorio para checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# pk_test_... para ambiente de pruebas

# Tiendanube — App ID público (obtener en partners.tiendanube.com)
VITE_TIENDANUBE_APP_ID=your_tiendanube_app_id

# Sentry — error monitoring (opcional, obtener DSN en sentry.io)
# VITE_SENTRY_DSN=https://xxxxx@oxxxx.ingest.sentry.io/yyyyyyy
# VITE_APP_VERSION=1.0.0

# ============================================================
# EDGE FUNCTIONS — estos secretos van en Supabase Dashboard
# Edge Functions > Secrets — NO incluirlos aquí
# Comando: supabase secrets set KEY=value
# ============================================================

# Stripe (claves secretas — solo Edge Functions)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Tiendanube (secretos — solo Edge Functions)
# TIENDANUBE_CLIENT_ID=your_client_id
# TIENDANUBE_CLIENT_SECRET=your_client_secret

# Mercado Pago (solo Edge Functions)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Anthropic — para IA (solo Edge Functions)
# ANTHROPIC_API_KEY=sk-ant-...

# Resend — para emails transaccionales y campañas (solo Edge Functions)
# RESEND_API_KEY=re_...

# AFIP — para facturación electrónica (solo Edge Functions)
# AFIP_CERT=-----BEGIN CERTIFICATE-----...
# AFIP_KEY=-----BEGIN RSA PRIVATE KEY-----...
# AFIP_CUIT=20123456789

# Web Push / Push Notifications (sesión 46)
# Clave pública VAPID — segura para exponer en frontend
